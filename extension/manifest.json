{
  "manifest_version": 3,
  "name": "MeetNote - Google Meet Recorder",
  "version": "0.1.0",
  "description": "Record Google Meet tab audio locally and save it as a WebM file.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "MeetNote"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content/meet-detector.js"],
      "run_at": "document_idle"
    }
  ]
}
